# Puerto del servidor
PORT=3000

# URI de conexión a MongoDB
# Local: mongodb://localhost:27017/restaurant
# Docker: mongodb://mongo:27017/restaurant
# Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/restaurant
MONGO_URI=mongodb://localhost:27017/restaurant

# Secreto para firmar tokens JWT (¡CAMBIAR en producción!)
JWT_SECRET=cambiar_este_secreto_en_produccion
